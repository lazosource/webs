# Local development (SQLite): keep as-is.
# Production (Postgres, e.g. Neon or Vercel Postgres): set to your
# provider's connection string and switch the `provider` in
# prisma/schema.prisma from "sqlite" to "postgresql". See README.md.
DATABASE_URL="file:./dev.db"

# Random secret used to sign short-lived "game session" tokens so score
# submissions can be sanity-checked server-side. Generate a real one for
# production with: openssl rand -hex 32
SCORE_SIGNING_SECRET="change-me-to-a-long-random-string"
