// CasperSource database schema.
//
// Uses SQLite locally (see .env) and is Postgres-ready for production:
// just point DATABASE_URL at a Postgres connection string (e.g. Neon or
// Vercel Postgres) and change `provider` below to "postgresql", then run
// `npm run db:deploy`. See README.md for full deploy steps.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Score {
  id         String   @id @default(cuid())
  playerName String
  gameSlug   String
  score      Int
  createdAt  DateTime @default(now())

  @@index([gameSlug, score])
  @@index([playerName])
}
